    "yaml": "^2.9.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@mcp-ui/client": "^5.17.1",
    "@playwright/test": "^1.64.1",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@reduxjs/toolkit": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/jsdom": "^28.0.3",
    "@types/ldapjs": "^3.0.6",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
