    "drizzle-kit": "^0.31.11",
    "i18next": "^26.4.7",
    "ldapjs": "^3.0.7",
    "openai": "^6.49.0",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.0",
    "react-i18next": "^17.0.20",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.0.0",
    "react-router-dom": "^6.20.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.1.0",
    "tailwindcss": "^3.4.0",
