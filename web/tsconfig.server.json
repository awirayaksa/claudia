{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "paths": {
      "@shared/*": ["./shared/*"],
      // Shared files under ../src and ../electron pick up web's packages
      // Subpath exports aren't applied through "*" (it maps to plain files)
      "@modelcontextprotocol/sdk/*": ["./node_modules/@modelcontextprotocol/sdk/dist/esm/*"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": ["server", "shared", "drizzle.config.ts", "tsup.config.ts", "vitest.config.ts"]
}
