{
  "name": "claudia-web",
  "version": "0.11.2",
  "private": true,
  "description": "Multi-user, self-hostable web version of Claudia",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsup",
    "start": "node dist/server/index.cjs",
    "type-check": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate-cli.ts",
    "check:shared-deps": "node scripts/check-shared-deps.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "cli": "tsx server/cli.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@babel/standalone": "^7.29.10",
    "@electric-sql/pglite": "^0.4.6",
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@mozilla/readability": "^0.6.0",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@viz-js/viz": "^3.25.0",
    "@xmldom/xmldom": "^0.9.10",
    "adm-zip": "^0.5.17",
    "axios": "^1.6.0",
    "croner": "^9.1.0",
    "docx": "^9.6.1",
    "drizzle-orm": "^0.45.4",
    "eventsource-parser": "^1.1.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "gpt-tokenizer": "^3.4.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.47",
    "ldapts": "^8.2.0",
    "mammoth": "^1.12.0",
    "marked": "^15.0.12",
    "mermaid": "^11.17.2",
    "pdf-parse": "^1.1.1",
    "pdfmake": "^0.3.12",
    "piscina": "^5.3.2",
    "postgres": "^3.4.9",
    "pptxgenjs": "^4.0.1",
    "pyodide": "^0.28.3",
    "qrcode": "^1.5.4",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
